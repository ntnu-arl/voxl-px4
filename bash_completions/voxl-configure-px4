_voxl-configure-px4(){
	local OPTS=('help enable disable factory_enable starling_v2 sentinel_v1 fpv_revB d0005_v2 d0006_v1 d0008')
	COMPREPLY=()
	if [ "$COMP_CWORD" -eq 1 ]; then
		COMPREPLY=( $(compgen -W '${OPTS}' -- ${COMP_WORDS[COMP_CWORD]}) )
		return 0
	fi
}

complete -F _voxl-configure-px4 voxl-configure-px4
